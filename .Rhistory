# single-cell analysis package
library(Seurat)
# plotting and data science packages
library(tidyverse)
library(cowplot)
library(patchwork)
# co-expression network analysis packages:
library(WGCNA)
library(hdWGCNA)
# network analysis & visualization package:
library(igraph)
# using the cowplot theme for ggplot
theme_set(theme_cowplot())
# set random seed for reproducibility
set.seed(12345)
# optionally enable multithreading
enableWGCNAThreads(nThreads = 8)
##############
# load data
setwd("~/Documentos/Posgrado/Tesis/Beeline")
outputdir <- "~/Documentos/Posgrado/Tesis/hdWGCNA/data/juli"
inputExpr <- read.csv("inputs/example/GSD/ExpressionData.csv",
row.names = 1,
check.names = FALSE) # first column = gene names
inputExpr[1:5,1:5]
dim(inputExpr) # 19   2000
inputExpr <- as.matrix(inputExpr)
# read as seurat
seurat_object <- CreateSeuratObject(counts = inputExpr, project = "GSD", min.cells = 0, min.features = 0)
seurat_object #19 features 2000 samples
# preprocesing
seurat_object@assays$RNA$data = seurat_object@assays$RNA$counts
seurat_object <- FindVariableFeatures(seurat_object, selection.method = "vst", nfeatures = 2000)
seurat_object <- ScaleData(seurat_object, features = VariableFeatures(seurat_object))
seurat_object
# dimensional reduction
seurat_object <- RunPCA(seurat_object, features = VariableFeatures(object = seurat_object))
# clustering
seurat_object <- FindNeighbors(seurat_object, dims = 1:10)
seurat_object <- FindClusters(seurat_object, resolution = 0.5)
# genes expresados en al menos el 5% de las células
seurat_obj <- SetupForWGCNA(
seurat_object,
gene_select = "fraction", # the gene selection approach
fraction = 0.05, # fraction of cells that a gene needs to be expressed in order to be included
wgcna_name = "tutorial" # the name of the hdWGCNA experiment
)
seurat_obj
# metacells
seurat_obj <- MetacellsByGroups(
seurat_obj = seurat_obj,
group.by = c("RNA_snn_res.0.5"), # specify the columns in seurat_obj@meta.data to group by
reduction = 'pca', # select the dimensionality reduction to perform KNN on
k = 5, # nearest-neighbors parameter
max_shared = 2, # maximum number of shared cells between two metacells
ident.group = 'RNA_snn_res.0.5' # set the Idents of the metacell seurat object
)
# normalize metacell expression matrix:
seurat_obj <- NormalizeMetacells(seurat_obj)
seurat_obj <- ScaleMetacells(seurat_obj, features=VariableFeatures(seurat_obj))
seurat_obj <- RunPCAMetacells(seurat_obj, features=VariableFeatures(seurat_obj))
seurat_obj
seurat_obj$metacell_grouping
seurat_obj$orig.ident
seurat_obj <- RunHarmonyMetacells(seurat_obj, group.by.vars='orig.ident')
seurat_obj <- RunUMAPMetacells(seurat_obj, reduction='harmony', dims=1:15)
p1 <- DimPlotMetacells(seurat_obj, group.by='cell_type') + umap_theme() + ggtitle("Cell Type")
p2 <- DimPlotMetacells(seurat_obj, group.by='Sample') + umap_theme() + ggtitle("Sample")
p1 | p2
p1 <- DimPlotMetacells(seurat_obj, group.by='RNA_snn_res.0.5') + umap_theme() + ggtitle("Cell Type")
p2 <- DimPlotMetacells(seurat_obj, group.by='orig.ident') + umap_theme() + ggtitle("Sample")
p1 | p2
seurat_obj$orig.ident
head(seurat_obj@misc$tutorial$wgcna_metacell_obj)
?DimPlotMetacells
DimPlotMetacells(seurat_obj, "pca")
DimPlotMetacells(seurat_obj, reduction="pca")
plot_pca <- DimPlotMetacells(seurat_obj, reduction="pca")
ggsave(filename = file.path(outputdir,"pca_metacells.png") , plot=plot_pca)
head(seurat_obj@misc$tutorial$wgcna_metacell_obj)
